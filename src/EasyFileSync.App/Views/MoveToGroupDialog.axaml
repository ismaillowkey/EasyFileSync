<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyFileSync.App.Views.MoveToGroupDialog"
        Title="Move Job to Group"
        Width="390" Height="200"
        MinWidth="390" MinHeight="200"
        MaxWidth="390" MaxHeight="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

  <Grid RowDefinitions="*,Auto">
    <!-- Area Pilihan Group -->
    <StackPanel Grid.Row="0" Margin="22,18,22,10" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Image Source="{SvgImage /Assets/Icons/folder.svg}" Width="18" Height="18" VerticalAlignment="Center" />
        <TextBlock Name="TxtPrompt" Text="Select target group for job:" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center" />
      </StackPanel>
      <ComboBox Name="CmbGroups" Height="30" FontSize="12" HorizontalAlignment="Stretch"
                Background="#FFFFFF" BorderBrush="#B4C2D2" CornerRadius="2" />
      <TextBlock Name="TxtHint" Text="Jobs in the same group are organized together in the sidebar." FontSize="11" Foreground="#64748B" />
    </StackPanel>

    <!-- Bottom Buttons Bar -->
    <Border Grid.Row="1" Background="#EDF1F7" BorderBrush="#D8DFE8" BorderThickness="0,1,0,0" Padding="14,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Name="BtnOk" Content="Move" Width="75" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="#2B6CB0" Foreground="White" FontWeight="SemiBold" FontSize="11.5" CornerRadius="3" IsDefault="True" />
        <Button Name="BtnCancel" Content="Cancel" Width="75" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="#E2E8F0" Foreground="#333333" FontSize="11.5" CornerRadius="3" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
