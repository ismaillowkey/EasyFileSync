<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyFileSync.App.Views.NewJobWindow"
        Title="New EasyFileSync Job"
        Width="420" Height="400"
        MinWidth="420" MinHeight="400"
        MaxWidth="420" MaxHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF">

  <Grid RowDefinitions="*,Auto">
    <!-- Area Konten Utama -->
    <Panel Grid.Row="0">
      <!-- Watermark Lingkaran Sync Transparan di Latar Belakang Kanan Bawah -->
      <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="220" Height="220" IsHitTestVisible="False">
        <Path Fill="#80A5C8"
              Opacity="0.10"
              Data="M 190,110 C 190,154 154,190 110,190 C 86,190 64,179 50,162 L 68,144 C 78,155 93,162 110,162 C 139,162 162,139 162,110 C 162,81 139,58 110,58 C 95,58 81,64 71,74 L 94,97 L 25,97 L 25,28 L 51,54 C 66,39 87,30 110,30 C 154,30 190,66 190,110 Z" />
      </Canvas>

      <StackPanel Margin="24,20,24,10">
        <!-- Judul Enter Job Name -->
        <TextBlock Text="Enter Job Name"
                   FontWeight="Bold"
                   FontSize="13"
                   Foreground="#000000"
                   Margin="0,0,0,8" />

        <!-- Input Nama Job -->
        <TextBox x:Name="JobNameBox"
                 Height="28"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 CornerRadius="3"
                 BorderBrush="#ABADB3"
                 BorderThickness="1"
                 Background="#FFFFFF"
                 Padding="6,2" />

        <TextBlock x:Name="ErrorLabel"
                   Foreground="#D32F2F"
                   FontSize="11"
                   Margin="0,3,0,0"
                   IsVisible="False" />

        <!-- Judul Select Job Type -->
        <TextBlock Text="Select Job type"
                   FontWeight="Bold"
                   FontSize="13"
                   Foreground="#000000"
                   Margin="0,16,0,10" />

        <!-- Opsi 1: Backup (Left to Right) -->
        <RadioButton x:Name="RadioBackup"
                     GroupName="JobType"
                     Content="Backup"
                     FontSize="13"
                     FontWeight="Normal"
                     Foreground="#000000"
                     IsChecked="True" />

        <!-- Deskripsi Backup -->
        <TextBlock Text="One-way Job: Copy files and folders (and their deletions) from the Left side folder to the Right side folder."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#000000"
                   LineHeight="17"
                   Margin="24,4,0,0" />

        <!-- Opsi 2: Synchronize (2-Way) -->
        <RadioButton x:Name="RadioSync"
                     GroupName="JobType"
                     Content="Synchronize"
                     FontSize="13"
                     FontWeight="Normal"
                     Foreground="#000000"
                     Margin="0,14,0,0" />

        <!-- Deskripsi Synchronize -->
        <TextBlock Text="Two-way Job: Propagate changes (file changed, renamed, or deleted) from Left to Right and from Right to Left. Hidden and System files are excluded by default"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#000000"
                   LineHeight="17"
                   Margin="24,4,0,0" />
      </StackPanel>
    </Panel>

    <!-- Footer Bar Biru Lembut Sesuai GoodSync Asli (Tanpa Tulisan Tutorial) -->
    <Border Grid.Row="1"
            Height="48"
            Background="#CADAE8"
            BorderBrush="#B4C7D7"
            BorderThickness="0,1,0,0"
            Padding="14,8">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Sisi Kiri: Kosong (tulisan tutorial telah dihapus sesuai instruksi) -->
        <Panel Grid.Column="0" />

        <!-- Sisi Kanan: Tombol OK & Cancel -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="BtnOk"
                  Content="OK"
                  Width="78"
                  Height="26"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  FontSize="12"
                  Background="#FFFFFF"
                  BorderBrush="#8E9CA8"
                  BorderThickness="1"
                  CornerRadius="3"
                  Click="OnOkClick"
                  IsDefault="True" />

          <Button x:Name="BtnCancel"
                  Content="Cancel"
                  Width="78"
                  Height="26"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  FontSize="12"
                  Background="#FFFFFF"
                  BorderBrush="#8E9CA8"
                  BorderThickness="1"
                  CornerRadius="3"
                  Click="OnCancelClick"
                  IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

