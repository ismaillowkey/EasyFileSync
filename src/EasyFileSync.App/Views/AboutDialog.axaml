<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyFileSync.App.Views.AboutDialog"
        Title="About EasyFileSync"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

  <Grid RowDefinitions="Auto,Auto">

    <!-- Konten Utama Card -->
    <StackPanel Grid.Row="0" Margin="24,20,24,18" Spacing="16">

      <!-- Header: Logo, Nama Aplikasi, Versi -->
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <Border Grid.Column="0" Width="48" Height="48" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Margin="0,0,16,0">
          <Image Source="{SvgImage /Assets/Icons/job.svg}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="EasyFileSync" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
          <TextBlock Name="TxtVersion" Text="Version 0.3.5 (64-bit)" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />
          <TextBlock Text="Fast, reliable file synchronization &amp; backup utility" FontSize="11" Foreground="#64748B" />
        </StackPanel>
      </Grid>

      <Border Height="1" Background="#E2E8F0" />

      <!-- Deskripsi Fitur -->
      <StackPanel Spacing="8">
        <TextBlock Text="EasyFileSync is designed for rapid folder comparison, bi-directional sync, scheduled background automations, and parallel multi-file transfers."
                   FontSize="11.5" Foreground="#334155" LineHeight="17" TextWrapping="Wrap" />

        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12,10">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Architecture:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,2,16,2" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 10.0 (Windows x64 Native)" FontSize="11" Foreground="#1E293B" Margin="0,2,0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="UI Framework:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,2,16,2" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Avalonia UI 11.3 XAML" FontSize="11" Foreground="#1E293B" Margin="0,2,0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Storage Drivers:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,2,16,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Local Disk, SMB/Network Share, FTP/FTPS" FontSize="11" Foreground="#1E293B" Margin="0,2,0,2" />
          </Grid>
        </Border>

        <TextBlock Text="© 2026 EasyFileSync. All rights reserved." FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0" />
      </StackPanel>

    </StackPanel>

    <!-- Bottom Buttons Bar -->
    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="BtnOk" Content="OK" Width="80" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5" CornerRadius="3" IsDefault="True" IsCancel="True" />
      </StackPanel>
    </Border>

  </Grid>
</Window>

