<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyFileSync.App.Views.DeleteCompareItemDialog"
        Title="Delete Item"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

  <Grid RowDefinitions="Auto,Auto">
    <!-- Area Pertanyaan Konfirmasi & Pilihan Hapus -->
    <StackPanel Grid.Row="0" Margin="22,18,22,16" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="🗑️" FontSize="22" VerticalAlignment="Center" />
        <TextBlock Name="TxtTitlePrompt" Text="Delete file or folder?"
                   FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Name="TxtItemName" Text="Item name" FontSize="11.5" FontWeight="Medium" Foreground="#333333" Margin="32,0,0,0" TextTrimming="CharacterEllipsis" />

      <!-- Pilihan Sisi Hapus (Jika ada di kedua sisi) -->
      <StackPanel Name="PanelChoice" Spacing="6" Margin="32,4,0,0" IsVisible="False">
        <TextBlock Text="Select target location to delete:" FontSize="11" Foreground="#555555" />
        <RadioButton Name="RbDeleteBoth" Content="Delete from both Left and Right folders" GroupName="DeleteTarget" IsChecked="True" FontSize="11.5" />
        <RadioButton Name="RbDeleteLeft" Content="Delete from Left folder only" GroupName="DeleteTarget" FontSize="11.5" />
        <RadioButton Name="RbDeleteRight" Content="Delete from Right folder only" GroupName="DeleteTarget" FontSize="11.5" />
      </StackPanel>

      <!-- Keterangan Single Side (Jika hanya ada di kiri atau kanan) -->
      <TextBlock Name="TxtSingleSideNotice" Text="" FontSize="11" Foreground="#666666" Margin="32,4,0,0" TextWrapping="Wrap" />

      <TextBlock Text="Warning: This operation cannot be undone." FontSize="11" Foreground="#D32F2F" Margin="32,0,0,0" />
    </StackPanel>

    <!-- Bottom Buttons Bar -->
    <Border Grid.Row="1" Background="#EDF1F7" BorderBrush="#D8DFE8" BorderThickness="0,1,0,0" Padding="14,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Name="BtnDelete" Content="Delete" Width="80" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="#D32F2F" Foreground="White" FontWeight="SemiBold" FontSize="11.5" CornerRadius="3" IsDefault="True" />
        <Button Name="BtnCancel" Content="Cancel" Width="75" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="#E2E8F0" Foreground="#333333" FontSize="11.5" CornerRadius="3" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>

