<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyFileSync.App.Views.JobOptionsDialog"
        Title="Job Options"
        Width="720" Height="640"
        MinWidth="660" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

  <Window.Styles>
    <Style Selector="ListBoxItem.nav-item">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBoxItem.nav-item:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#0078D7" />
    </Style>
    <Style Selector="ListBoxItem.nav-item:selected TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.mini-btn">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C2C9D1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.mini-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F4F8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <!-- Body: Sidebar Navigasi Kiri + Panel Konten Kanan -->
    <Grid Grid.Row="0" ColumnDefinitions="170,1,*">

      <!-- Sidebar Tab Kiri -->
      <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E2E6EA" BorderThickness="0,0,1,0">
        <ListBox Name="ListOptionsTabs" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,6,0,0">
          <!-- 1. General -->
          <ListBoxItem Classes="nav-item">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Image Source="{SvgImage /Assets/Icons/settings.svg}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <!-- 2. Filters -->
          <ListBoxItem Classes="nav-item">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Image Source="{SvgImage /Assets/Icons/filter.svg}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Filters" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <!-- 3. Analyze -->
          <ListBoxItem Classes="nav-item">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Image Source="{SvgImage /Assets/Icons/analyze.svg}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Analyze" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <!-- 4. Sync -->
          <ListBoxItem Classes="nav-item">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Image Source="{SvgImage /Assets/Icons/sync.svg}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Sync" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <!-- 5. Auto -->
          <ListBoxItem Classes="nav-item">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Image Source="{SvgImage /Assets/Icons/autorunoff.svg}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Auto" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Border>

      <!-- Garis Pemisah Vertikal -->
      <Border Grid.Column="1" Background="#E2E6EA" Width="1" />

      <!-- Area Konten Tab Kanan -->
      <Grid Grid.Column="2" Background="#FFFFFF">

        <!-- TAB 1: FILTERS (Persis Layout Screenshot Paduka Raja.ST) -->
        <ScrollViewer Name="PanelTabFilters" IsVisible="True" Padding="18,16">
          <StackPanel Spacing="14">
            <TextBlock Text="Choose files to be included or excluded from synchronization."
                       FontSize="12" Foreground="#333333" Margin="0,0,0,2" />

            <!-- Section 1: Include All of -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Include All of (no lines: include all)" FontSize="11.5" Foreground="#333333" VerticalAlignment="Center" />
                <Button Name="BtnIncludeCopy" Grid.Column="1" Classes="mini-btn" Content="Copy All" Margin="3,0" />
                <Button Name="BtnIncludePaste" Grid.Column="2" Classes="mini-btn" Content="Paste" Margin="3,0" />
                <Button Name="BtnIncludeAdd" Grid.Column="3" Classes="mini-btn" Content="➕" Width="26" Margin="3,0" HorizontalContentAlignment="Center" ToolTip.Tip="Add include rule" />
                <Button Name="BtnIncludeRemove" Grid.Column="4" Classes="mini-btn" Content="➖" Width="26" Margin="3,0" HorizontalContentAlignment="Center" ToolTip.Tip="Remove last rule" />
              </Grid>

              <TextBox Name="TxtIncludeFilters" Height="110" FontSize="11.5" AcceptsReturn="True" TextWrapping="NoWrap"
                       Background="#FFFFFF" BorderBrush="#C2C9D1" CornerRadius="2" FontFamily="Consolas, Segoe UI, sans-serif" />
            </StackPanel>

            <!-- Section 2: Exclude All after Include -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Exclude All after Include (no lines: no exclude)" FontSize="11.5" Foreground="#333333" VerticalAlignment="Center" />
                <Button Name="BtnFilterHelp" Grid.Column="1" Classes="mini-btn" Content="?" Width="26" Margin="3,0" HorizontalContentAlignment="Center" ToolTip.Tip="Filter Syntax Help" />
                <Button Name="BtnExcludeCopy" Grid.Column="2" Classes="mini-btn" Content="Copy All" Margin="3,0" />
                <Button Name="BtnExcludePaste" Grid.Column="3" Classes="mini-btn" Content="Paste" Margin="3,0" />
                <Button Name="BtnExcludeAdd" Grid.Column="4" Classes="mini-btn" Content="➕" Width="26" Margin="3,0" HorizontalContentAlignment="Center" ToolTip.Tip="Add exclude rule" />
                <Button Name="BtnExcludeRemove" Grid.Column="5" Classes="mini-btn" Content="➖" Width="26" Margin="3,0" HorizontalContentAlignment="Center" ToolTip.Tip="Remove last rule" />
              </Grid>

              <TextBox Name="TxtExcludeFilters" Height="120" FontSize="11.5" AcceptsReturn="True" TextWrapping="NoWrap"
                       Background="#FFFFFF" BorderBrush="#C2C9D1" CornerRadius="2" FontFamily="Consolas, Segoe UI, sans-serif" />
            </StackPanel>

            <!-- Checkboxes Filter Khusus -->
            <StackPanel Spacing="6" Margin="0,4,0,0">
              <CheckBox Name="ChkExcludeEmptyFolders" Content="Exclude empty folders" FontSize="11.5" Foreground="#333333" />
              <CheckBox Name="ChkExcludeHidden" Content="Exclude Hidden files and folders" FontSize="11.5" Foreground="#333333" />
              <CheckBox Name="ChkExcludeSystem" Content="Exclude System files and folders" FontSize="11.5" Foreground="#333333" />
              <CheckBox Name="ChkExcludeTemp" Content="Exclude Temporary files and folders" FontSize="11.5" Foreground="#333333" IsChecked="True" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- TAB 0: GENERAL -->
        <ScrollViewer Name="PanelTabGeneral" IsVisible="False" Padding="20,16">
          <StackPanel Spacing="16">
            <!-- Job Name -->
            <StackPanel Spacing="6">
              <TextBlock Text="Job Name:" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" />
              <TextBox Name="TxtJobName" Height="30" FontSize="12" VerticalContentAlignment="Center"
                       Background="#FFFFFF" BorderBrush="#B4C2D2" CornerRadius="2" />
            </StackPanel>

            <!-- Job Direction -->
            <StackPanel Spacing="8">
              <TextBlock Text="Job Direction:" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" />
              <Border BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="4" Padding="12,10" Background="#F8FAFC">
                <StackPanel Spacing="8">
                  <RadioButton Name="RbTwoWay" Content="Two-Way (⇄) - Synchronize changes in both directions"
                               GroupName="DirectionGroup" FontSize="11.5" Foreground="#333333" />
                  <RadioButton Name="RbLeftToRight" Content="Left to Right (➔) - Backup from left folder to right folder"
                               GroupName="DirectionGroup" FontSize="11.5" Foreground="#333333" />
                  <RadioButton Name="RbRightToLeft" Content="Right to Left (⬅) - Backup from right folder to left folder"
                               GroupName="DirectionGroup" FontSize="11.5" Foreground="#333333" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Compare By (Compare Mode) -->
            <StackPanel Spacing="8">
              <TextBlock Text="Compare by:" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" />
              <Border BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="4" Padding="12,10" Background="#F8FAFC">
                <StackPanel Spacing="8">
                  <RadioButton Name="RbCompareTimeAndSize" Content="Compare by Modification Time (Timestamp) and Size (Recommended)"
                               GroupName="CompareGroup" FontSize="11.5" Foreground="#333333" IsChecked="True" />
                  <RadioButton Name="RbCompareSizeOnly" Content="Compare by Size only (Ignore modified timestamp)"
                               GroupName="CompareGroup" FontSize="11.5" Foreground="#333333" />
                  <RadioButton Name="RbCompareChecksum" Content="Compare by Checksum / Hash (MD5 / SHA-256 Content)"
                               GroupName="CompareGroup" FontSize="11.5" Foreground="#333333" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- TAB 2: ANALYZE -->
        <ScrollViewer Name="PanelTabAnalyze" IsVisible="False" Padding="20,16">
          <StackPanel Spacing="16">
            <TextBlock Text="Analysis &amp; Compare Options:" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" />

            <Border BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="4" Padding="12,10" Background="#F8FAFC">
              <StackPanel Spacing="10">
                <CheckBox Name="ChkDetectRenames" Content="Detect file moves and renames" FontSize="11.5" Foreground="#333333" IsChecked="True" />
                <CheckBox Name="ChkPropagateDeletions" Content="Propagate deletions to target folder" FontSize="11.5" Foreground="#333333" IsChecked="True" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- TAB 3: SYNC -->
        <ScrollViewer Name="PanelTabSync" IsVisible="False" Padding="20,16">
          <StackPanel Spacing="16">
            <TextBlock Text="Synchronization Options:" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" />
            <Border BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="4" Padding="12,10" Background="#F8FAFC">
              <StackPanel Spacing="10">
                <CheckBox Name="ChkCopyAttributes" Content="Copy file attributes and permissions" FontSize="11.5" Foreground="#333333" IsChecked="True" />
                <CheckBox Name="ChkSaveBackups" Content="Save deleted or replaced files to backup history" FontSize="11.5" Foreground="#333333" IsChecked="True" />
              </StackPanel>
            </Border>

            <!-- Parallel Transfers Setting -->
            <Border BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="4" Padding="12,10" Background="#F8FAFC">
              <StackPanel Spacing="6">
                <TextBlock Text="Parallel Transfers:" FontSize="12" FontWeight="SemiBold" Foreground="#222222" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Maximum parallel transfers:" FontSize="11.5" Foreground="#555555" VerticalAlignment="Center" />
                  <NumericUpDown Name="NumParallelTransfers" Minimum="1" Maximum="10" Value="3" Increment="1" Width="100" Height="28" VerticalAlignment="Center" />
                  <TextBlock Text="(Default: 3, Min: 1, Max: 10)" FontSize="11" Foreground="#777777" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Set lower values (1-2) for slower PCs (Core i3 / HDD) to prevent disk overloading."
                           FontSize="10.5" Foreground="#666666" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- TAB 4: AUTO -->
        <ScrollViewer Name="PanelTabAuto" IsVisible="False" Padding="20,16">
          <StackPanel Spacing="16">
            <TextBlock Text="Automated Synchronization:" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" />
            <Border BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="4" Padding="12,10" Background="#F8FAFC">
              <StackPanel Spacing="10">
                <CheckBox Name="ChkAutoOnChange" Content="On File Change (Real-time monitoring)" FontSize="11.5" Foreground="#333333" />
                <CheckBox Name="ChkAutoOnTimer" Content="Periodically by timer" FontSize="11.5" Foreground="#333333" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>

    <!-- Bottom Buttons Bar (Persis Screenshot) -->
    <Border Grid.Row="1" Background="#EDF1F7" BorderBrush="#D8DFE8" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Name="LinkProgramOptions" Text="About EasyFileSync" FontSize="11" Foreground="#0078D7" Cursor="Hand" TextDecorations="Underline" VerticalAlignment="Center" />
          <TextBlock Name="LinkFilterHelp" Text="Help" FontSize="11" Foreground="#0078D7" Cursor="Hand" TextDecorations="Underline" VerticalAlignment="Center" />
        </StackPanel>

        <Button Name="BtnSave" Grid.Column="2" Content="Save" Width="80" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="#FFFFFF" BorderBrush="#ADBDCE" BorderThickness="1" Foreground="#222222" FontSize="11.5" CornerRadius="2" Margin="0,0,8,0" IsDefault="True" />

        <Button Name="BtnCancel" Grid.Column="3" Content="Cancel" Width="80" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="#FFFFFF" BorderBrush="#ADBDCE" BorderThickness="1" Foreground="#222222" FontSize="11.5" CornerRadius="2" IsCancel="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
